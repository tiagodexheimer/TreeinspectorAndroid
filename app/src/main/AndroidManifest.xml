<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TreeInspectorAndroid"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyA63oBbIvuMFgim3bzrQecanKn-kZfr24A" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
        android:name=".RoutesActivity"
        android:label="Lista de Rotas"
        android:parentActivityName=".MainActivity" />
        <activity
            android:name=".RotaDetalheActivity"
            android:label="Detalhes da Rota"
            android:parentActivityName=".RoutesActivity" />
        <activity
            android:name=".VistoriaActivity"
            android:label="Vistoria da Demanda"
            android:parentActivityName=".RotaDetalheActivity" />

    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/item_border"> <TextView
    android:id="@+id/textViewRotaNome"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Nome da Rota"
    android:textSize="18sp"
    android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewDataCriacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Criada em: dd/mm/aaaa"
        android:textColor="#000000"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textViewContagemDemandas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 demandas"
        android:textColor="#000000"
        android:textSize="14sp" />

</LinearLayout>